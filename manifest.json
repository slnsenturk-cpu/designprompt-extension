{
  "manifest_version": 3,
  "name": "VibeDesign",
  "version": "3.0.0",
  "description": "Extract any website's design system into DESIGN.md, Skills & design tokens for Claude Code, Cursor, Codex, Stitch, Lovable, v0, Bolt",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel", "identity", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.js", "lib/color-utils.js", "lib/noise-filter.js", "lib/shadow-utils.js", "lib/picker.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://vibedesign.tech/*",
      "https://*.vibedesign.tech/*"
    ]
  }
}
