#!/usr/bin/env bash
# VibeDesign — pre-commit hook.
#
# Lives in scripts/hooks (tracked) rather than .git/hooks (not tracked), so it
# is version-controlled and shared. Activate with:
#
#     git config core.hooksPath scripts/hooks
#
# Three checks, all fast enough to run on every commit (~1s total):
#   1. syntax-check every staged .js file
#   2. run the full test suite
#   3. refuse a commit containing anything shaped like a provider API key
#
# Bypass with `git commit --no-verify` only when you know why.
#
# NOTE: checks 1 and 2 run against the WORKING TREE, not the staged snapshot.
# With a partially-staged file the tree can pass while the commit is broken.
# Stashing to fix that risks losing work in a hook, which is a worse trade for
# a repo with no build step. Check 3 reads staged content directly, because
# that is the one where a false pass actually matters.

set -uo pipefail

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[0;33m'; OFF=$'\033[0m'
fail() { printf '%s✗ pre-commit: %s%s\n' "$RED" "$1" "$OFF" >&2; exit 1; }
note() { printf '%s  %s%s\n' "$YELLOW" "$1" "$OFF" >&2; }

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# ── 1. syntax ─────────────────────────────────────────────────────────────
# Skip the vendored Supabase bundle: it is minified and not ours to fix.
js_files=$(printf '%s\n' "$staged" | grep -E '\.js$' | grep -v 'lib/supabase\.min\.js' || true)
if [ -n "$js_files" ]; then
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if ! node --check "$f" 2>/tmp/vd-syntax.$$; then
      note "$(cat /tmp/vd-syntax.$$)"; rm -f /tmp/vd-syntax.$$
      fail "$f has a syntax error"
    fi
    rm -f /tmp/vd-syntax.$$
  done <<< "$js_files"
fi

# ── 2. tests ──────────────────────────────────────────────────────────────
if ls tests/*.test.js >/dev/null 2>&1; then
  if ! out=$(node --test tests/*.test.js 2>&1); then
    printf '%s\n' "$out" | grep -E '^(✖|  Assertion|ℹ (tests|pass|fail))' | head -30 >&2
    fail "the test suite is failing — fix it or commit with --no-verify"
  fi
  printf '%s✓ %s%s\n' "$GREEN" "$(printf '%s\n' "$out" | grep -E '^ℹ pass' | tr -s ' ')" "$OFF"
fi

# ── 3. no provider API keys ───────────────────────────────────────────────
# Reads the STAGED blob, so a key cannot slip through by being unstaged in the
# working tree. docs/ is excluded: the release checklist quotes these patterns.
KEY_RE='sk-ant-[A-Za-z0-9_-]{8,}|sk-[A-Za-z0-9]{20,}|AIza[A-Za-z0-9_-]{20,}|gsk_[A-Za-z0-9]{20,}|xai-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}'
while IFS= read -r f; do
  case "$f" in docs/*) continue ;; esac
  if git show ":$f" 2>/dev/null | grep -qE "$KEY_RE"; then
    note "$(git show ":$f" | grep -nE "$KEY_RE" | head -3)"
    fail "$f looks like it contains a provider API key"
  fi
done <<< "$staged"

exit 0
