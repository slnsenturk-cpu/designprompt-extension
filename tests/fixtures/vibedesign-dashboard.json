  "animations": [
    {
      "name": "bounce",
      "from": "0%, 100% { transform: translateY(-25%); animation-timing-function: cubic-bezier(0.8, 0, 1, 1); }",
      "to": "50% { transform: none; animation-timing-function: cubic-bezier(0, 0, 0.2, 1); }"
    },
    {
      "name": "ping",
      "from": "75%, 100% { transform: scale(2); opacity: 0; }",
      "to": null
    },
    {
      "name": "pulse",
      "from": "50% { opacity: 0.5; }",
      "to": null
    },
    {
      "name": "spin",
      "from": "100% { transform: rotate(360deg); }",
      "to": null
    },
    {
      "name": "enter",
      "from": "0% { opacity: var(--tw-enter-opacity, 1); transform: translate3d(var(--tw-enter-translate-x, 0),var(--tw-enter-translate-y, 0),0)",
      "to": null
    },
    {
      "name": "exit",
      "from": "100% { opacity: var(--tw-exit-opacity, 1); transform: translate3d(var(--tw-exit-translate-x, 0),var(--tw-exit-translate-y, 0),0)",
      "to": null
    },
    {
      "name": "accordion-up",
      "from": "0% { height: var(--radix-accordion-content-height); }",
      "to": "100% { height: 0px; }"
    },
    {
      "name": "accordion-down",
      "from": "0% { height: 0px; }",
      "to": "100% { height: var(--radix-accordion-content-height); }"
    },
    {
      "name": "swipe-out-left",
      "from": "0% { transform: var(--y) translate(var(--swipe-amount-x)); opacity: 1; }",
      "to": "100% { transform: var(--y) translate(calc(var(--swipe-amount-x) - 100%)); opacity: 0; }"
    },
    {
      "name": "swipe-out-right",
      "from": "0% { transform: var(--y) translate(var(--swipe-amount-x)); opacity: 1; }",
      "to": "100% { transform: var(--y) translate(calc(var(--swipe-amount-x) + 100%)); opacity: 0; }"
    },
    {
      "name": "swipe-out-up",
      "from": "0% { transform: var(--y) translateY(var(--swipe-amount-y)); opacity: 1; }",
      "to": "100% { transform: var(--y) translateY(calc(var(--swipe-amount-y) - 100%)); opacity: 0; }"
    },
    {
      "name": "swipe-out-down",
      "from": "0% { transform: var(--y) translateY(var(--swipe-amount-y)); opacity: 1; }",
      "to": "100% { transform: var(--y) translateY(calc(var(--swipe-amount-y) + 100%)); opacity: 0; }"
    }
  ],
