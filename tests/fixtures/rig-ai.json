  "animations": [
    {
      "name": "btn-glitch",
      "from": "0% { transform: translate(0px); text-shadow: none; opacity: 1; }",
      "to": "100% { transform: translate(0px); text-shadow: none; opacity: 1; }"
    },
    {
      "name": "glitch-subtle-1",
      "from": "0% { clip: rect(12px, 9999px, 5px, 0px); }",
      "to": "100% { clip: rect(60px, 9999px, 100px, 0px); }"
    },
    {
      "name": "glitch-subtle-2",
      "from": "0% { clip: rect(65px, 9999px, 100px, 0px); }",
      "to": "100% { clip: rect(10px, 9999px, 60px, 0px); }"
    },
    {
      "name": "pulse-ring",
      "from": "0%, 100% { opacity: 0.4; transform: scale(1); }",
      "to": "50% { opacity: 0; transform: scale(2); }"
    },
    {
      "name": "blink",
      "from": "0%, 100% { opacity: 1; }",
      "to": "50% { opacity: 0; }"
    },
    {
      "name": "ticker",
      "from": "0% { transform: translate(0px); }",
      "to": "100% { transform: translate(-50%); }"
    },
    {
      "name": "glitch-shift",
      "from": "0%, 90%, 100% { transform: translate(0px); }",
      "to": "98% { transform: translate(1px); }"
    },
    {
      "name": "hdr-glow-pulse",
      "from": "0%, 100% { opacity: 0.4; filter: blur(8px); }",
      "to": "50% { opacity: 0.7; filter: blur(12px); }"
    },
    {
      "name": "watermark-glitch",
      "from": "0% { transform: translateY(-50%) translate(0px); filter: none; opacity: 0.08; }",
      "to": "100% { transform: translateY(-50%) translate(0px); filter: none; opacity: 0.08; }"
    },
    {
      "name": "pupil-glitch",
      "from": "0%, 100% { opacity: 1; transform: translate(0px); }",
      "to": "76% { opacity: 1; transform: translate(0px); }"
    },
    {
      "name": "disconnect-drift-left",
      "from": "0%, 80%, 100% { transform: translate(0px); opacity: 0.5; }",
      "to": "95% { transform: translate(-4px, 1px); opacity: 0.4; }"
    },
    {
      "name": "disconnect-drift-right",
      "from": "0%, 80%, 100% { transform: translate(0px); opacity: 0.5; }",
      "to": "95% { transform: translate(4px, -1px); opacity: 0.4; }"
    },
    {
      "name": "signal-flicker",
      "from": "0%, 92%, 100% { opacity: 1; transform: translate(0px); }",
      "to": "97% { opacity: 0.3; transform: translate(-1px); }"
    },
    {
      "name": "howProgressFill",
      "from": "0% { height: 0%; }",
      "to": "100% { height: 100%; }"
    },
    {
      "name": "terminalLineIn",
      "from": "0% { opacity: 0; }",
      "to": "100% { opacity: 1; }"
    },
    {
      "name": "wl-spin",
      "from": "100% { transform: rotate(360deg); }",
      "to": null
    }
  ],
